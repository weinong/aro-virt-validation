# Ready-to-source settings for building the day-2 RHCOS kernel layer with Paolo
# Bonzini's L1VH test kernel for RHCOS 10 (el10_2).
#
#   source images/rhcos-kernel-layer/l1vh.env
#
# Kernel: 6.12.0-211.49.1.1794_2798046552.el10_2 (x86_64), UNSIGNED developer
# build from https://bonzini.fedorapeople.org/kernel-l1vh/ . RHCOS 10 installs
# kernel, kernel-core, kernel-modules, kernel-modules-core, kernel-modules-extra,
# so all five are replaced together.

# Substring checked by scripts/12b-verify-kernel-layer.sh after the swap.
export EXPECTED_KERNEL="6.12.0-211.49.1.1794_2798046552.el10_2"

# ---------------------------------------------------------------------------
# Recommended: local carrier path (self-contained; no in-cluster egress to the
# Anubis-protected download host, and works with unsigned RPMs).
#
#   1. Stage the five RPMs outside the repo, e.g.:
#        mkdir -p /tmp/kernel-l1vh && cd /tmp/kernel-l1vh
#        base=https://bonzini.fedorapeople.org/kernel-l1vh
#        v=6.12.0-211.49.1.1794_2798046552.el10_2
#        for p in kernel kernel-core kernel-modules kernel-modules-core kernel-modules-extra; do
#          curl -A curl/8.5.0 -fLO "$base/$p-$v.x86_64.rpm"; done
#   2. KERNEL_RPM_DIR=/tmp/kernel-l1vh make build-kernel-rpm-carrier
#   3. KERNEL_RPM_SOURCE=local make rhcos-kernel-layer
# ---------------------------------------------------------------------------
export KERNEL_RPM_SOURCE="${KERNEL_RPM_SOURCE:-local}"
# Unsigned developer kernel: sha256 lock is still enforced by 12a.
export ALLOW_UNSIGNED_KERNEL_RPMS="true"

# ---------------------------------------------------------------------------
# Alternative: COPR/URL path. The in-cluster build pod fetches these directly.
# Requires build-pod egress to bonzini.fedorapeople.org (the .rpm blobs are not
# Anubis-challenged, but confirm reachability from the cluster first).
#
#   KERNEL_RPM_SOURCE=copr make rhcos-kernel-layer
# ---------------------------------------------------------------------------
export KERNEL_RPM_URLS="\
https://bonzini.fedorapeople.org/kernel-l1vh/kernel-6.12.0-211.49.1.1794_2798046552.el10_2.x86_64.rpm \
https://bonzini.fedorapeople.org/kernel-l1vh/kernel-core-6.12.0-211.49.1.1794_2798046552.el10_2.x86_64.rpm \
https://bonzini.fedorapeople.org/kernel-l1vh/kernel-modules-6.12.0-211.49.1.1794_2798046552.el10_2.x86_64.rpm \
https://bonzini.fedorapeople.org/kernel-l1vh/kernel-modules-core-6.12.0-211.49.1.1794_2798046552.el10_2.x86_64.rpm \
https://bonzini.fedorapeople.org/kernel-l1vh/kernel-modules-extra-6.12.0-211.49.1.1794_2798046552.el10_2.x86_64.rpm"
